{
  "name": "@parallalaxstudio/react-health-monitor",
  "version": "1.0.0",
  "description": "Composant React & Next.js universel et autonome pour la surveillance des certificats SSL/HTTPS et le diagnostic de performance et latence d'API.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/next-handler.d.ts",
      "import": "./dist/server/next-handler.js",
      "default": "./dist/server/next-handler.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ParallalaxStudio/react-health-monitor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "nextjs",
    "health-check",
    "ssl-monitor",
    "api-latency",
    "performance",
    "dashboard",
    "admin"
  ],
  "author": "ParallalaxStudio",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0 || ^19.0.0",
    "@types/react-dom": "^18.3.0 || ^19.0.0",
    "typescript": "^5.0.0"
  }
}
